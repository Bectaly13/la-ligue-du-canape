<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ : splash SYSTÈME par défaut = icône adaptative de l'app (arrondie par le système)
         sur fond blanc. On ne force pas d'icône custom → Android affiche l'icône de l'app telle quelle. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:background">@android:color/white</item>
    </style>

</resources>
